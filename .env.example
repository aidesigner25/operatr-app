# Do not add provider, tool, OAuth, or encryption secrets with a NEXT_PUBLIC_
# prefix: Next.js includes those values in browser code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags default to off. Enable only after the server feature exists.
OPERATR_ENABLE_CHAT=false
OPERATR_ENABLE_TAVILY=false
OPERATR_ENABLE_APIFY=false
OPERATR_ENABLE_GOOGLE_WORKSPACE=false

# Supabase — added in Phase 1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep this server-only. It is not required by the Phase 1 request path, which
# uses the authenticated user's JWT so RLS remains enforced.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets — added in Phase 1 and never committed.
# A base64url-encoded, random 32-byte AES-256 key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPERATR_KEY_ENCRYPTION_SECRET=
# Identifier stored alongside encrypted credentials to support future key rotation.
OPERATR_KEY_ENCRYPTION_KEY_ID=primary-v1
# GOOGLE_OAUTH_CLIENT_SECRET=

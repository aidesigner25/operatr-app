# Do not add provider, tool, OAuth, or encryption secrets with a NEXT_PUBLIC_
# prefix: Next.js includes those values in browser code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags default to off. Enable only after the server feature exists.
OPERATR_ENABLE_CHAT=false
OPERATR_ENABLE_TAVILY=false
OPERATR_ENABLE_APIFY=false
OPERATR_ENABLE_GOOGLE_WORKSPACE=false

# Supabase — added in Phase 1.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets — added in Phase 1 and never committed.
# OPERATR_KEY_ENCRYPTION_SECRET=
# GOOGLE_OAUTH_CLIENT_SECRET=
